# Service URLs
ASR_SERVICE_URL=http://your-asr-host:10000
BACKEND_PORT=8000

# Temporary files
TEMP_DIR=temp_files

# ElevenLabs (for 2D Avatar and LiveAvatar TTS)
ELEVEN_LABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_VERIFY_SSL=false
ELEVENLABS_VOICE_ID=your-elevenlabs-voice-id
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# LiveAvatar (WebRTC 3D Avatar streaming)
LIVEAVATAR_API_KEY=your-liveavatar-api-key
LIVEAVATAR_DEFAULT_AVATAR=your-liveavatar-avatar-id
LIVEAVATAR_VERIFY_SSL=false

# Test Mode (for audio error fallback)
ENABLE_TEST_MODE=false
TEST_FALLBACK_MESSAGE=Hello, I am the AI Assistant.

# Admin Panel
ADMIN_PASSWORD=your-admin-password

# In-cluster service URLs (set automatically via docker-compose; override for local dev)
MONGO_URL=mongodb://mongodb:27017
BAYMAX_DB=baymax
CONTENT_MANAGER_URL=http://content-manager:80
RETRIEVER_URL=http://retriever:80
PARSE_JOB_URL=http://parse-job:8087
MINIO_URL=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Kokoro TTS (alternative to ElevenLabs — select via admin panel)
KOKORO_API_URL=http://your-kokoro-host/tts
TTS_API_KEY=your-tts-api-key
TTS_ADMIN_KEY=your-tts-admin-key
KOKORO_TTS_VOICE=af_sarah

# LLM (OpenAI-compatible chat completions endpoint)
LLM_API_URL=https://your-vllm-host/v1
LLM_API_KEY=your-bearer-token
LLM_MODEL=openai/gpt-oss-20b
LLM_VERIFY_SSL=false

# First-boot default for admin config seed
DEFAULT_LLM_PROFILE=openai/gpt-oss-20b
